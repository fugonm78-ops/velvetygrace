function abrirModal(idServicio) {
    const data = serviciosDetalle[idServicio];
    const modal = document.getElementById('modalServicio');
    const modalBody = document.getElementById('modalBody');

    if (!data) return;

    const listaPreciosHtml = data.precios && data.precios.length > 0
        ? data.precios.map(p => `<li><span>${p.tipo}</span> <strong>${p.precio}</strong></li>`).join('')
        : '<li><span>Consultar precio</span></li>';

    const listaIncluyeHtml = data.incluye && data.incluye.length > 0
        ? data.incluye.map(item => `<li>• ${item}</li>`).join('')
        : '';

    modalBody.innerHTML = `
        ${data.imagen ? `<img src="${data.imagen}" alt="${data.titulo}" style="width: 100%; height: 220px; object-fit: cover; border-radius: 12px; margin-bottom: 15px;">` : ''}
        
        <h2 class="modal-title">${data.titulo || 'Servicio'}</h2>
        
        <p style="font-size: 14px; color: #6d5b50; margin-bottom: 15px; line-height: 1.6;">${data.descripcion || ''}</p>
        
        ${data.duracion ? `
            <p style="font-size: 13px; color: var(--dorado); font-weight: 600; margin-bottom: 15px;">
                ⏱️ Duración estimada: ${data.duracion}
            </p>
        ` : ''}

        ${data.recomendadoPara ? `
            <div style="background: #fdf8f5; padding: 12px 15px; border-left: 3px solid var(--dorado); margin-bottom: 15px; border-radius: 4px;">
                <strong style="font-size: 13px; color: var(--texto-oscuro);">Ideal para:</strong>
                <p style="font-size: 13px; color: #6d5b50; margin: 4px 0 0 0;">${data.recomendadoPara}</p>
            </div>
        ` : ''}

        <h4 style="color: var(--texto-oscuro); margin-top: 15px; font-family: 'Playfair Display', serif;">Precios y Opciones</h4>
        <ul class="modal-info-list">
            ${listaPreciosHtml}
        </ul>

        ${listaIncluyeHtml ? `
            <h4 style="color: var(--texto-oscuro); margin-top: 15px; font-family: 'Playfair Display', serif;">El servicio incluye:</h4>
            <ul style="list-style: none; padding: 0; font-size: 13px; color: #6d5b50; line-height: 1.8;">
                ${listaIncluyeHtml}
            </ul>
        ` : ''}
    `;

    modal.style.display = 'flex';
}

function cerrarModal() {
    const modal = document.getElementById('modalServicio');
    modal.style.display = 'none';
}


