let carruselActual = {
    categoria: null,
    indice: 0
};

function abrirModalCatalogo(idCatalogo) {
    const data = catalogoDetalle[idCatalogo];
    if (!data || !data.fotos || data.fotos.length === 0) return;

    carruselActual.categoria = idCatalogo;
    carruselActual.indice = 0;

    renderizarCarrusel();
    document.getElementById('modalCatalogo').style.display = 'flex';
}

function renderizarCarrusel() {
    const data = catalogoDetalle[carruselActual.categoria];
    const foto = data.fotos[carruselActual.indice];
    const modalBody = document.getElementById('modalCatalogoBody');

    const tieneVariasFotos = data.fotos.length > 1;

    modalBody.innerHTML = `
        <h2 class="modal-title">${data.titulo}</h2>
        <p style="font-size: 14px; color: #6d5b50; margin-bottom: 15px;">${data.descripcion}</p>

        <div class="galeria-carrusel">
            ${tieneVariasFotos ? `<button class="carrusel-btn prev" onclick="cambiarFoto(-1)">&#10094;</button>` : ''}
            <div class="carrusel-img-container">
                <img src="${foto.url}" alt="${foto.titulo}">
            </div>
            ${tieneVariasFotos ? `<button class="carrusel-btn next" onclick="cambiarFoto(1)">&#10095;</button>` : ''}
        </div>

        <div class="galeria-info">
            <h3>${foto.titulo}</h3>
            <p>${foto.info}</p>
            <span class="contador-foto">${carruselActual.indice + 1} / ${data.fotos.length}</span>
        </div>
    `;
}

function cambiarFoto(direccion) {
    const data = catalogoDetalle[carruselActual.categoria];
    if (!data) return;

    carruselActual.indice += direccion;

    if (carruselActual.indice < 0) {
        carruselActual.indice = data.fotos.length - 1;
    } else if (carruselActual.indice >= data.fotos.length) {
        carruselActual.indice = 0;
    }

    renderizarCarrusel();
}

function cerrarModalCatalogo() {
    document.getElementById('modalCatalogo').style.display = 'none';
}


window.onclick = function(event) {
    const modalServicio = document.getElementById('modalServicio');
    modalCatalogo = document.getElementById('modalCatalogo');

    if (event.target === modalServicio) {
        cerrarModal();
    }
    if (event.target === modalCatalogo) {
        cerrarModalCatalogo();
    }
};